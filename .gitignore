__pycache__/
*.pyc
*.log
node_modules/
dist/
build/
.env
.venv/
.DS_Store

# Protocol working state — installed by .rokct/initiate.py, not committed.
.rokct/skills/
.rokct/tmp/

# /lib/ is generated by compose on every build - main.dart included -
# so none of it is tracked. Anything app-specific belongs in a manifest
# (app_routes, or host_routes in composer.json), which IS tracked.
# Anchored to the repo root on purpose: an unanchored lib/ would also
# ignore every .rokct/cache/<sdk>/lib/, stripping the tracked caches.
/lib/

# Python bytecode from running the .rokct compose/install scripts.
.rokct/__pycache__/

# Flutter/pub working state, regenerated on every compose and build.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock
ios/Podfile.lock
# Composed SDK caches and the per-run install record. install_state.json
# is rewritten by every compose, so tracking it breaks the zero-drift check
# and trips Gitleaks on its content digests (false positive).
.rokct/cache/
.rokct/cache/install_state.json
